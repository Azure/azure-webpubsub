<Project>
  <Import Project="version.props" />

  <PropertyGroup>
    <!-- The release signing service completes the strong-name signature. -->
    <!-- Public key source: https://github.com/Azure/azure-sdk-for-net/blob/main/eng/MSSharedLibKey.snk -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build/MSSharedLibKey.snk</AssemblyOriginatorKeyFile>
    <DelaySign>true</DelaySign>
    <PublicSign>false</PublicSign>
  </PropertyGroup>
</Project>
