{
  "name": "github-pages",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "build:workaround:init:command": "git clone https://github.com/wanlwanl/docusaurus && cd docusaurus && yarn && yarn build:packages && cd ..",
    "build:workaround:link:react": "npm link ./docusaurus/node_modules/react/",
    "build:workaround": "node ./docusaurus/packages/docusaurus/bin/docusaurus.mjs build .",
    "deploy:workaround": "node ./docusaurus/packages/docusaurus/bin/docusaurus.mjs deploy .",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-pages": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@fluentui/react": "^8.72.2",
    "@mdx-js/react": "^3.0.0",
    "browser-cookies": "^1.2.0",
    "clsx": "^1.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.2.0",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.2.0",
    "react-responsive": "^9.0.0-beta.6",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@tsconfig/docusaurus": "^2.0.9",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.18",
    "prettier": "^2.7.1",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@babel/core": "7.29.6",
    "body-parser": "1.20.6",
    "follow-redirects": "1.16.0",
    "http-proxy-middleware": "2.0.10",
    "joi": "17.13.4",
    "launch-editor": "2.14.1",
    "prismjs": "1.30.0",
    "qs": "6.15.3",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
